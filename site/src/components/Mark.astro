---
// The mark: concentric arcs from a filled dot. An amphitheatre seen from
// above and a sound wave are the same drawing, and the mark is that drawing
// with the back half left off, because a voice only goes one way.
// docs/BRAND.md § Mark. Decorative here; the wordmark carries the name.
interface Props {
	size?: number;
	class?: string;
}
const { size = 30, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<circle cx="7" cy="16" r="3" fill="#C4552E"></circle>
	<path d="M12 9.5a10 10 0 0 1 0 13" stroke="#C4552E" stroke-width="2.6" fill="none" stroke-linecap="round"></path>
	<path d="M17.5 6.5a16 16 0 0 1 0 19" stroke="#C4552E" stroke-width="2.6" fill="none" stroke-linecap="round" opacity=".72"></path>
	<path d="M23 3.5a22 22 0 0 1 0 25" stroke="#C4552E" stroke-width="2.6" fill="none" stroke-linecap="round" opacity=".45"></path>
</svg>
