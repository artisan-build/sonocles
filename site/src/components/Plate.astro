---
// An illustration. The plates were generated once by art/make.py from the
// prompts in docs/BRAND.md § The plates and live in src/assets/plates; Astro
// serves them resized and as WebP so the hero is no longer 1.5 MB of PNG.
// The drawing is unchanged.
//
// `size` is the landing page's three figure widths: full measure, `mid`
// (square plates at full measure swamp the text they illustrate) and `sm`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	size?: 'full' | 'mid' | 'sm';
	class?: string;
	loading?: 'lazy' | 'eager';
}
const { src, alt, caption, size = 'full', class: cls, loading = 'lazy' } = Astro.props;
const sizes = { full: '(max-width: 1000px) 92vw, 920px', mid: '(max-width: 620px) 92vw, 560px', sm: '(max-width: 620px) 92vw, 330px' }[size];
const widths = { full: [480, 760, 920, 1536], mid: [480, 560, 1024], sm: [330, 660] }[size];
---

<figure class:list={['plate', `plate--${size}`, cls]}>
	<Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" loading={loading} decoding="async" />
	{caption && <figcaption set:html={caption} />}
</figure>

<style>
	.plate {
		margin: 38px 0 0;
	}
	.plate img {
		width: 100%;
		height: auto;
		display: block;
	}
	.plate--mid {
		max-width: 560px;
		margin-left: auto;
		margin-right: auto;
	}
	.plate--mid figcaption {
		text-align: center;
		margin-left: auto;
		margin-right: auto;
	}
	.plate--sm {
		max-width: 330px;
	}
	figcaption {
		margin: 13px 0 0;
		font-size: 14.5px;
		color: var(--ink-faint);
		max-width: 60ch;
	}
	figcaption :global(b) {
		color: var(--ink-soft);
		font-weight: 600;
	}
</style>
