{
  // Cloudflare Pages (Direct Upload) for sonocles.com.
  //
  // Astro builds into dist/, so that is the output directory. The site used
  // to be one HTML file whose source directory was its output; it is not any
  // more, which is why `make deploy` and the workflow both build first.
  //
  // The custom domain is attached once, via the API — wrangler 4 removed the
  // `pages domain` subcommand:
  //     curl -X POST \
  //       ".../accounts/$ACCOUNT/pages/projects/sonocles/domains" \
  //       -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  //       --data '{"name":"sonocles.com"}'
  // Already done for sonocles.com.
  "name": "sonocles",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "./dist"
}
